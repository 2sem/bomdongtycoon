    "dot.tutorial.farm.subtitle" : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "빈 밭을 누르면 씨앗을 심고,\n자라는 밭을 누르면 물을 줘요.\n다 자란 봄동을 누르면 수확해요.\n첫 번째 밭은 알바생이 돌봐요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap an empty plot to plant,\na growing plot to water it faster,\nand a ripe bomdong to harvest.\nYour starting part-timer tends the first plot."
          }
        }
      }
    },
